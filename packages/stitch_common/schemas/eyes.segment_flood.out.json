{
  "$defs": {
    "FeatureCollection": {
      "additionalProperties": false,
      "description": "Minimal GeoJSON FeatureCollection (WGS84). Features are kept as plain dicts.",
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "features": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Features",
          "type": "array"
        },
        "type": {
          "const": "FeatureCollection",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "features"
      ],
      "title": "FeatureCollection",
      "type": "object"
    },
    "SourceScene": {
      "additionalProperties": false,
      "properties": {
        "acquired": {
          "format": "date-time",
          "title": "Acquired",
          "type": "string"
        },
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "sensor": {
          "title": "Sensor",
          "type": "string"
        }
      },
      "required": [
        "sensor",
        "acquired",
        "scene_id"
      ],
      "title": "SourceScene",
      "type": "object"
    },
    "Validation": {
      "additionalProperties": false,
      "properties": {
        "eval_dataset": {
          "title": "Eval Dataset",
          "type": "string"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "validated_for_region": {
          "title": "Validated For Region",
          "type": "boolean"
        }
      },
      "required": [
        "validated_for_region",
        "eval_dataset",
        "note"
      ],
      "title": "Validation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Confidence"
    },
    "extent_geojson": {
      "$ref": "#/$defs/FeatureCollection"
    },
    "flood_extent_km2": {
      "minimum": 0.0,
      "title": "Flood Extent Km2",
      "type": "number"
    },
    "model_variant": {
      "anyOf": [
        {
          "enum": [
            "unet-resnet18-s1-int8",
            "unet-resnet18-s1-fp16",
            "unet-resnet18-s1-fp32",
            "vh-threshold-baseline"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Variant"
    },
    "permanent_water_km2": {
      "minimum": 0.0,
      "title": "Permanent Water Km2",
      "type": "number"
    },
    "reference_overlay_geojson": {
      "anyOf": [
        {
          "$ref": "#/$defs/FeatureCollection"
        },
        {
          "type": "null"
        }
      ]
    },
    "reference_overlay_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reference Overlay Note"
    },
    "source_scene": {
      "$ref": "#/$defs/SourceScene"
    },
    "tiles_processed": {
      "minimum": 0,
      "title": "Tiles Processed",
      "type": "integer"
    },
    "valid_fraction": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid Fraction"
    },
    "validation": {
      "$ref": "#/$defs/Validation"
    }
  },
  "required": [
    "flood_extent_km2",
    "extent_geojson",
    "permanent_water_km2",
    "confidence",
    "tiles_processed",
    "source_scene",
    "validation",
    "reference_overlay_geojson"
  ],
  "title": "SegmentFloodOut",
  "type": "object"
}
