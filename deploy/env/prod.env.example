# Production settings for the VPS. Installed as /opt/stitch/prod.env (mode 600, root) by
# deploy/bin/vps_setup.sh. Names and non-secret defaults only; never commit the filled file
# (prod.env is git-ignored). TAG is not set here: stitch-deploy passes the release sha.
COMPOSE_PROJECT_NAME=stitch
# GHCR owner (GitHub user or org). stitch-local = images built on the VPS, no registry.
GH_OWNER=stitch-local
# Optional organs: `eyes` (and `voice` once that organ exists). Organs not started must be
# listed in STITCH_ORGANS_DISABLED so the Brain reports them `disabled`.
COMPOSE_PROFILES=eyes
STITCH_ORGANS_DISABLED=voice
# --- gateway ---
# `:80` = plain HTTP on the IP (before DNS). stitch-check-dns sets the domain once the A record
# resolves to this host; Caddy then obtains the certificate and redirects HTTP to HTTPS.
SITE_ADDRESS=:80
# Dry run only: ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=
# Start with max-age=300; raise to max-age=31536000 once HTTPS is verified (no preload).
HSTS=max-age=300
# --- behaviour (demo defaults) ---
STITCH_MODE=demo
STITCH_LLM_PROVIDER=fake
STITCH_TTS_PROVIDER=prerendered
STITCH_WHISPER_MODEL=base
# Voice: deepgram (English TTS; Urdu falls back to prerendered) and STT deepgram or whisper.
STITCH_STT_PROVIDER=whisper
# Model id for a live LLM provider (Nebius default below). STITCH_LLM_PROVIDER stays `fake`
# until the Brain selects the LLM per request mode (docs/decisions.md, deployment).
STITCH_LLM_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# --- keys: only with deploy/compose.live.yaml (egress network; COMPOSE_OVERRIDES in
# /opt/stitch/deploy.conf). Leave empty for the demo. ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_APPLICATION_CREDENTIALS=
