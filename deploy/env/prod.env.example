# Production settings for the VPS. Copy to /opt/stitch/prod.env (mode 600, owner deploy).
# Names only; fill values on the VPS. Never commit the filled file (prod.env is git-ignored).
COMPOSE_PROJECT_NAME=stitch
GH_OWNER=
TAG=
COMPOSE_PROFILES=
STITCH_ORGANS_DISABLED=

# --- TLS (Caddy automatic HTTPS) ---
SITE_ADDRESS=stitch.aashirnoman.dev
ACME_EMAIL=
# Dry run: the Let's Encrypt staging directory URL; remove the line for the production CA.
ACME_CA=
# Start with max-age=300; raise to max-age=31536000 once HTTPS is verified (no preload).
HSTS=

# --- behaviour (demo defaults) ---
STITCH_MODE=
STITCH_LLM_PROVIDER=
STITCH_TTS_PROVIDER=
STITCH_WHISPER_MODEL=

# --- keys: only with deploy/compose.live.yaml (egress network) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_APPLICATION_CREDENTIALS=
