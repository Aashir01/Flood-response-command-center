# Stitch Docker Compose settings. Copy to `.env` (git-ignored) only if you need to change a default.
# A clean `docker compose up` needs no .env at all: demo mode, fake LLM, no keys, no network.
# Variable names only for secrets; never commit values. Production values live in
# /opt/stitch/prod.env on the VPS (see deploy/env/prod.env.example and deploy/README.md).

# --- selection ---
COMPOSE_PROJECT_NAME=stitch
# Image tag; CD sets the commit SHA. `local` = built on this machine.
TAG=local
# GHCR owner (lowercase GitHub user or org) used in image names ghcr.io/<owner>/stitch-<svc>.
GH_OWNER=
# Optional organs: `eyes`, `voice`, or `full` (both). Empty = core stack only.
COMPOSE_PROFILES=
# Organs the Brain reports as `disabled` (default eyes,voice). Clear it when you enable both.
STITCH_ORGANS_DISABLED=
# Gateway bind address and port on the host (local and CI). Production uses 80/443.
WEB_BIND=
WEB_PORT=

# --- behaviour ---
STITCH_MODE=
# fake (default, offline) | anthropic | openai | nebius
STITCH_LLM_PROVIDER=
# Model id for the chosen provider, e.g. meta-llama/Llama-3.3-70B-Instruct on Nebius
STITCH_LLM_MODEL=
STITCH_TTS_PROVIDER=
STITCH_WHISPER_MODEL=
STITCH_EMBED_MODEL=
STITCH_RERANK_MODEL=
STITCH_LAZY_LOAD=

# --- build only ---
# Directory with already fetched Library models (for example data/raw/models) to skip the
# ~1 GB Hugging Face download; empty = fetch at build time with pinned revisions and sha256.
STITCH_MODELS_CONTEXT=

# --- keys (leave empty here; set only in prod.env on the VPS, used with deploy/compose.live.yaml) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Nebius Token Factory (OpenAI-compatible). NEBIUS_BASE_URL defaults to https://api.tokenfactory.nebius.com/v1/
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_APPLICATION_CREDENTIALS=
