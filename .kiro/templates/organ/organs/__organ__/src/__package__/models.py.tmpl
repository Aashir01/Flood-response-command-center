"""Models and published schemas for ${server_name}.

The contract models live in ``stitch_common.organs.${organ}``; do not copy them. Add models here
only for organ-internal data (they are not part of the MCP contract).

``TOOL_SCHEMAS`` maps each tool name to its input JSON Schema. ``scripts/check_contracts.py``
compares it with the exported schema ``packages/stitch_common/schemas/${organ}.<tool>.in.json``.
"""

from __future__ import annotations

from typing import Any

from stitch_common.organs import ORGAN_TOOLS

TOOL_NAMES: tuple[str, ...] = ${tools_tuple}

TOOL_SCHEMAS: dict[str, dict[str, Any]] = {
    name: ORGAN_TOOLS["${organ}"][name].input.model_json_schema(mode="validation")
    for name in TOOL_NAMES
}
