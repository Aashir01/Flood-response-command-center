{
  "version": 8,
  "name": "stitch-ouija",
  "sources": {
    "context": {
      "type": "geojson",
      "data": "/map/context.geojson"
    },
    "districts": {
      "type": "geojson",
      "data": "/map/districts.geojson"
    },
    "flood": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    },
    "reference": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    },
    "allocation": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#07090c"
      }
    },
    {
      "id": "context-fill",
      "type": "fill",
      "source": "context",
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "frame"
      ],
      "paint": {
        "fill-color": "#0d1217"
      }
    },
    {
      "id": "water-perm",
      "type": "fill",
      "source": "context",
      "filter": [
        "==",
        [
          "get",
          "kind"
        ],
        "permanent_water"
      ],
      "paint": {
        "fill-color": "#2a6f68",
        "fill-opacity": 0.55
      }
    },
    {
      "id": "flood-fill",
      "type": "fill",
      "source": "flood",
      "paint": {
        "fill-color": "#2cf5c0",
        "fill-opacity": 0.45
      }
    },
    {
      "id": "flood-glow-outer",
      "type": "line",
      "source": "flood",
      "paint": {
        "line-color": "#2cf5c0",
        "line-width": 10,
        "line-blur": 8,
        "line-opacity": 0.25
      }
    },
    {
      "id": "flood-glow-mid",
      "type": "line",
      "source": "flood",
      "paint": {
        "line-color": "#2cf5c0",
        "line-width": 5,
        "line-blur": 3,
        "line-opacity": 0.45
      }
    },
    {
      "id": "flood-edge",
      "type": "line",
      "source": "flood",
      "paint": {
        "line-color": "#2cf5c0",
        "line-width": 1.2,
        "line-opacity": 0.95
      }
    },
    {
      "id": "districts-line",
      "type": "line",
      "source": "districts",
      "paint": {
        "line-color": "#e8dfc8",
        "line-width": 0.8,
        "line-opacity": 0.7
      }
    },
    {
      "id": "reference-line",
      "type": "line",
      "source": "reference",
      "paint": {
        "line-color": "#e8dfc8",
        "line-width": 1.2,
        "line-dasharray": [
          2,
          2
        ],
        "line-opacity": 0.9
      }
    },
    {
      "id": "allocation-circles",
      "type": "circle",
      "source": "allocation",
      "paint": {
        "circle-color": "#ff9d3c",
        "circle-opacity": 0.55,
        "circle-stroke-color": "#ff9d3c",
        "circle-stroke-width": 1.5,
        "circle-radius": [
          "*",
          [
            "get",
            "k"
          ],
          [
            "sqrt",
            [
              "get",
              "people_covered"
            ]
          ]
        ]
      }
    }
  ]
}